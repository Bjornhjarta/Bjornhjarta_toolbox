<Window x:Class="Bjornhjarta.Desktop.ModelAssetLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Brand/BjornhjartaToolBox.ico"
        Title="Bjornhjarta - Model Asset Library" Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/Icons/raven-green.png" Width="40" Height="40" Margin="0,0,12,0" Stretch="Uniform"/>
                <StackPanel>
                    <TextBlock Text="MODEL ASSET LIBRARY" FontSize="24" FontWeight="Bold" Foreground="{StaticResource RuneBrush}"/>
                    <TextBlock Text="Import local GLB models and link them to selected pieces for 3D preview." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="LOCAL FILES ONLY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LibraryPathTextBox" Grid.Column="0" Padding="8" VerticalContentAlignment="Center"
                     Background="#19251D" Foreground="{StaticResource TextBrush}" BorderBrush="#465342"/>
            <Button Grid.Column="1" Content="Browse folder…" Click="BrowseFolder_Click" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Import GLB…" Click="ImportGlb_Click" Margin="8,0,0,0"/>
            <Button Grid.Column="3" Content="Scan library" Click="Scan_Click" Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="IMPORTED MODEL FILES" Foreground="{StaticResource RuneBrush}" FontWeight="Bold"/>
                        <TextBlock Text="GLB is recommended because meshes, materials and textures can be kept together in one file." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="AssetsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" Background="#111611" Foreground="{StaticResource TextBrush}"
                              RowBackground="#182018" AlternatingRowBackground="#202820" BorderBrush="#455A43"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionChanged="AssetsGrid_SelectionChanged"
                              MouseDoubleClick="AssetsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ASSET" Binding="{Binding DisplayName}" Width="1.5*"/>
                            <DataGridTextColumn Header="TYPE ID" Binding="{Binding TypeId}" Width="1.3*"/>
                            <DataGridTextColumn Header="FORMAT" Binding="{Binding Format}" Width="65"/>
                            <DataGridTextColumn Header="MESHES" Binding="{Binding MeshCount}" Width="62"/>
                            <DataGridTextColumn Header="MATERIALS" Binding="{Binding MaterialCount}" Width="78"/>
                            <DataGridTextColumn Header="TEXTURES" Binding="{Binding TextureCount}" Width="72"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="LibrarySummaryText" DockPanel.Dock="Bottom" Text="No library scan performed." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,8,2,0"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ASSET DETAILS &amp; TYPE ID MAPPING" Foreground="{StaticResource RuneBrush}" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Selected model" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="SelectedAssetText" Text="Select a model from the library." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <TextBlock Text="Display name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DisplayNameTextBox" Padding="7" Background="#19251D" Foreground="{StaticResource TextBrush}" BorderBrush="#465342"/>
                        <TextBlock Text="Enshrouded Type ID" Foreground="{StaticResource RuneBrush}" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TypeIdTextBox" Padding="7" Background="#19251D" Foreground="{StaticResource TextBrush}" BorderBrush="#465342"/>
                        <TextBlock Text="Source RenderModel GUID (optional)" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                        <TextBox x:Name="SourceGuidTextBox" Padding="7" Background="#19251D" Foreground="{StaticResource TextBrush}" BorderBrush="#465342"/>
                        <TextBlock Text="Notes" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                        <TextBox x:Name="NotesTextBox" Padding="7" Height="74" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="#19251D" Foreground="{StaticResource TextBrush}" BorderBrush="#465342"/>
                        <TextBlock Text="Geometry and materials" Foreground="{StaticResource RuneBrush}" FontWeight="Bold" Margin="0,14,0,5"/>
                        <TextBlock x:Name="MeshNamesText" Text="—" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ImageStorageText" Text="Images: —" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="Detected glTF material channels" Foreground="{StaticResource RuneBrush}" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock x:Name="MaterialChannelsText" Text="—" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="WPF 3D preview compatibility" Foreground="{StaticResource RuneBrush}" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock x:Name="PreviewCompatibilityText" Text="Not inspected" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Actual local GLB geometry bounds" Foreground="{StaticResource RuneBrush}" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock x:Name="GeometryDimensionsText" Text="Use Inspect GLB dimensions to calculate actual mesh bounds." Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Geometry numbers are in the GLB's own units. The conversion to Enshrouded meters, element pivots and correct placement are not verified." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"/>
                        <TextBlock Text="Texture packing" Foreground="{StaticResource RuneBrush}" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock x:Name="TexturePackingText" Text="Not recorded" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="WarningText" Foreground="#E6B75B" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock Text="Saving writes a .bjornhjarta.asset.json sidecar beside the model. It does not modify Enshrouded files." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Save model details / mapping" Click="SaveMetadata_Click"/>
                            <Button x:Name="AssignButton" Content="Quick assign to selected pieces" Click="Assign_Click" IsEnabled="False"/>
                            <Button x:Name="InspectGeometryButton" Content="Inspect GLB dimensions" Click="InspectGeometry_Click" IsEnabled="False"/>
                            <Button Content="Show file" Click="ShowFile_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Ready. Add GLB exports from your local model library." Foreground="{StaticResource RuneBrush}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Width="100" Margin="8,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
