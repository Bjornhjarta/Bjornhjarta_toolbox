<Window x:Class="Bjornhjarta.Desktop.EmlManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Brand/BjornhjartaToolBox.ico"
        Title="Bjornhjarta - EML Mod Manager v1.0.0 RC2"
        Width="1240" Height="900" MinWidth="1020" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/Brand/BjornhjartaToolBox.png" Width="42" Height="42" Margin="0,0,12,0"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel>
                    <TextBlock Text="EML MOD MANAGER" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Manage separate Enshrouded Client and Dedicated Server EML installations." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Refresh active profile" Click="Refresh_Click" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Separate installation profiles -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="235"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ACTIVE INSTALLATION" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="TargetProfileComboBox" Grid.Row="0" Grid.Column="1" Height="32" SelectionChanged="TargetProfileComboBox_SelectionChanged"
                          Background="#0E120E" Foreground="{StaticResource TextBrush}" BorderBrush="#455A43">
                    <ComboBoxItem Content="Enshrouded Client" Tag="Client"/>
                    <ComboBoxItem Content="Dedicated Server" Tag="DedicatedServer"/>
                </ComboBox>
                <TextBlock x:Name="ActiveProfileDescriptionText" Grid.Row="0" Grid.Column="2" Text="Actions apply only to the selected installation. Client and server settings remain separate." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,12,0"/>
                <Button Grid.Row="0" Grid.Column="3" Content="Scan both installations" Click="ScanBothProfiles_Click" VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="CLIENT:" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClientProfileSummaryText" Text="Not configured" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="5,0,22,0"/>
                    <TextBlock Text="DEDICATED SERVER:" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerProfileSummaryText" Text="Not configured" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active installation path -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="InstallationDirectoryLabel" Text="CLIENT INSTALLATION DIRECTORY" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                    <TextBox x:Name="GameRootTextBox" Height="31" VerticalContentAlignment="Center" Background="#0E120E" Foreground="{StaticResource TextBrush}" BorderBrush="#455A43" Padding="8,4"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse executable…" Click="BrowseGameRoot_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                <Button Grid.Column="2" Content="Scan active" Click="Refresh_Click" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- Active profile status cards -->
        <UniformGrid Grid.Row="3" Rows="1" Columns="3" Height="78" VerticalAlignment="Top" Margin="0,0,0,12">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="EML PROXY" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="LoaderStatusText" Text="Not scanned" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="MODS DIRECTORY" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="ModsStatusText" Text="Not scanned" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="6" Padding="13">
                <StackPanel>
                    <TextBlock Text="EML CONFIGURATION" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="ConfigStatusText" Text="Not scanned" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Active profile content -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="7" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="EML MOD PACKAGES" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="Active and disabled mods for this installation; changes require a stopped game/server." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Open mods folder" Click="OpenModsFolder_Click"/>
                    </DockPanel>
                    <DataGrid x:Name="ModsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              Background="#111611" Foreground="{StaticResource TextBrush}"
                              BorderBrush="#455A43" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" RowBackground="#151A15" AlternatingRowBackground="#1B211B"
                              MouseDoubleClick="ModsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STATE" Binding="{Binding EnabledStatus}" Width="0.6*"/>
                            <DataGridTextColumn Header="MOD ID" Binding="{Binding Id}" Width="0.8*"/>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.0*"/>
                            <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="0.65*"/>
                            <DataGridTextColumn Header="CAPABILITIES" Binding="{Binding CapabilitySummary}" Width="0.9*"/>
                            <DataGridTextColumn Header="VALIDATION" Binding="{Binding MetadataStatus}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="ScanWarningsText" Text="Scan warnings will appear here." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="Open selected mod folder" Click="OpenSelectedModFolder_Click"/>
                            <Button Content="Create mods folder" Click="CreateModsFolder_Click"/>
                            <Button Content="Import mod ZIP…" Click="ImportModZip_Click"/>
                            <Button Content="Enable / disable selected" Click="ToggleSelectedMod_Click"/>
                            <Button x:Name="InstallProxyButton" Content="Install / update EML proxy…" Click="InstallProxy_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#455A43" BorderThickness="1" CornerRadius="7" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="EML SETTINGS" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="These settings belong only to the selected installation and are read on a subsequent game launch." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,13" TextWrapping="Wrap"/>
                        <CheckBox x:Name="EnableConsoleCheckBox" Content="Enable EML console" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="UseExportCheckBox" Content="Enable export capability" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="EXPORT DIRECTORY (RELATIVE TO ACTIVE GAME FOLDER)" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ExportDirectoryTextBox" Text="export" Height="30" VerticalContentAlignment="Center" Background="#0E120E" Foreground="{StaticResource TextBrush}" BorderBrush="#455A43" Padding="8,4"/>
                        <Button x:Name="SaveConfigButton" Content="Save eml.json (create backup)" Click="SaveConfig_Click" HorizontalAlignment="Stretch" Margin="0,14,0,0"/>
                        <TextBlock Text="Only the active profile's eml.json is changed. Other JSON properties are preserved and an existing file is backed up." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Separator Background="#455A43" Margin="0,16,0,12"/>
                        <TextBlock Text="SHARED EML TOOLING" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="The selected official emm.exe is shared by both profiles. Each command targets the active installation only." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8"/>
                        <Button Content="Select emm.exe…" Click="SelectEmm_Click" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="EmmPathText" Text="emm.exe not selected" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                        <Button Content="Create mod template…" Click="CreateModTemplate_Click" HorizontalAlignment="Stretch" Margin="0,9,0,0"/>
                        <Button x:Name="ValidateButton" Content="Validate active installation's mods" Click="ValidateMods_Click" HorizontalAlignment="Stretch" IsEnabled="False" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Validation output -->
        <Border Grid.Row="5" Background="#101410" BorderBrush="#455A43" BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="EMM VALIDATION OUTPUT" Foreground="{StaticResource RuneBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="ValidationStatusText" Text="No validation run yet." Foreground="{StaticResource MutedBrush}" FontSize="10" DockPanel.Dock="Right"/>
                </DockPanel>
                <TextBox x:Name="ValidationOutputTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#090B09" Foreground="#CBD2C5" BorderBrush="#303A2E"
                         FontFamily="Consolas" FontSize="11" Padding="8" Text="EMM output will appear here."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="6" LastChildFill="False">
            <TextBlock Text="EML IS COMMUNITY SOFTWARE • REVIEW MOD SOURCES BEFORE INSTALLING" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Margin="0"/>
        </DockPanel>
    </Grid>
</Window>
